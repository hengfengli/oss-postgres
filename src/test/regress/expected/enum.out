(1 row)

---END---
---START---
SELECT 'purple'::rgb;
ERROR:  value for domain rgb violates check constraint "rgb_check"
---END---
---START---
SELECT 'purple'::rainbow::rgb;
ERROR:  value for domain rgb violates check constraint "rgb_check"
---END---
---START---
DROP DOMAIN rgb;
---END---
