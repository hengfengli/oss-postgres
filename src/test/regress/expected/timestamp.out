---START---
-- verify date_bin behaves the same as date_trunc for relevant intervals
-- case 1: AD dates, origin < input
SELECT
  str,
  interval,
  date_trunc(str, ts) = date_bin(interval::interval, ts, timestamp '2001-01-01') AS equal
FROM (
  VALUES
  ('week', '7 d'),
  ('day', '1 d'),
  ('hour', '1 h'),
  ('minute', '1 m'),
  ('second', '1 s'),
  ('millisecond', '1 ms'),
  ('microsecond', '1 us')
) intervals (str, interval),
(VALUES (timestamp '2020-02-29 15:44:17.71393')) ts (ts);
     str     | interval | equal 
-------------+----------+-------
 week        | 7 d      | t
 day         | 1 d      | t
 hour        | 1 h      | t
 minute      | 1 m      | t
 second      | 1 s      | t
 millisecond | 1 ms     | t
 microsecond | 1 us     | t
(7 rows)

---END---
---START---
-- case 2: BC dates, origin < input
SELECT
  str,
  interval,
  date_trunc(str, ts) = date_bin(interval::interval, ts, timestamp '2000-01-01 BC') AS equal
FROM (
  VALUES
  ('week', '7 d'),
  ('day', '1 d'),
  ('hour', '1 h'),
  ('minute', '1 m'),
  ('second', '1 s'),
  ('millisecond', '1 ms'),
  ('microsecond', '1 us')
) intervals (str, interval),
(VALUES (timestamp '0055-6-10 15:44:17.71393 BC')) ts (ts);
     str     | interval | equal 
-------------+----------+-------
 week        | 7 d      | t
 day         | 1 d      | t
 hour        | 1 h      | t
 minute      | 1 m      | t
 second      | 1 s      | t
 millisecond | 1 ms     | t
 microsecond | 1 us     | t
(7 rows)

---END---
