---START---
CREATE TABLE temp_float (gemini_pk serial PRIMARY KEY, f1 float8);
---END---
---START---
INSERT INTO TEMP_FLOAT (f1)
  SELECT float8(f1) FROM INT4_TBL;
---END---
---START---
INSERT INTO TEMP_FLOAT (f1)
  SELECT float8(f1) FROM INT2_TBL;
---END---
---START---
SELECT f1 FROM TEMP_FLOAT
  ORDER BY f1;
      f1       
---------------
   -2147483647
       -123456
        -32767
         -1234
             0
             0
          1234
         32767
        100000
        123456
    2147483647
 1000000000000
(12 rows)

---END---
---START---
CREATE TABLE temp_int4 (gemini_pk serial PRIMARY KEY, f1 int8);
---END---
---START---
INSERT INTO TEMP_INT4 (f1)
  SELECT int4(f1) FROM FLOAT8_TBL
  WHERE (f1 > -2147483647) AND (f1 < 2147483647);
---END---
---START---
INSERT INTO TEMP_INT4 (f1)
  SELECT int4(f1) FROM INT2_TBL;
---END---
---START---
SELECT f1 FROM TEMP_INT4
  ORDER BY f1;
   f1   
--------
 -32767
  -1234
  -1004
    -35
      0
      0
      0
   1234
  32767
 100000
(10 rows)

---END---
---START---
CREATE TABLE temp_int2 (gemini_pk serial PRIMARY KEY, f1 int2);
---END---
---START---
INSERT INTO TEMP_INT2 (f1)
  SELECT int2(f1) FROM FLOAT8_TBL
  WHERE (f1 >= -32767) AND (f1 <= 32767);
---END---
---START---
INSERT INTO TEMP_INT2 (f1)
  SELECT int2(f1) FROM INT4_TBL
  WHERE (f1 >= -32767) AND (f1 <= 32767);
---END---
---START---
SELECT f1 FROM TEMP_INT2
  ORDER BY f1;
  f1   
-------
 -1004
   -35
     0
     0
     0
(5 rows)

---END---
---START---
CREATE TABLE temp_group (gemini_pk serial PRIMARY KEY, f1 int8, f2 int8, f3 float8);
---END---
---START---
INSERT INTO TEMP_GROUP
  SELECT 1, (- i.f1), (- f.f1)
  FROM INT4_TBL i, FLOAT8_TBL f;
ERROR:  duplicate key value violates unique constraint "temp_group_pkey"
DETAIL:  Key (gemini_pk)=(1) already exists.
---END---
---START---
INSERT INTO TEMP_GROUP
  SELECT 2, i.f1, f.f1
  FROM INT4_TBL i, FLOAT8_TBL f;
ERROR:  duplicate key value violates unique constraint "temp_group_pkey"
DETAIL:  Key (gemini_pk)=(2) already exists.
---END---
---START---
SELECT DISTINCT f1 AS two FROM TEMP_GROUP ORDER BY 1;
 two 
-----
(0 rows)

---END---
---START---
SELECT f1 AS two, max(f3) AS max_float, min(f3) as min_float
  FROM TEMP_GROUP
  GROUP BY f1
  ORDER BY two, max_float, min_float;
 two | max_float | min_float 
-----+-----------+-----------
(0 rows)

---END---
---START---
-- GROUP BY a result column name is not legal per SQL92, but we accept it
-- anyway (if the name is not the name of any column exposed by FROM).
SELECT f1 AS two, max(f3) AS max_float, min(f3) AS min_float
  FROM TEMP_GROUP
  GROUP BY two
  ORDER BY two, max_float, min_float;
 two | max_float | min_float 
-----+-----------+-----------
(0 rows)

---END---
---START---
SELECT f1 AS two, (max(f3) + 1) AS max_plus_1, (min(f3) - 1) AS min_minus_1
  FROM TEMP_GROUP
  GROUP BY f1
  ORDER BY two, min_minus_1;
 two | max_plus_1 | min_minus_1 
-----+------------+-------------
(0 rows)

---END---
---START---
SELECT f1 AS two,
       max(f2) + min(f2) AS max_plus_min,
       min(f3) - 1 AS min_minus_1
  FROM TEMP_GROUP
  GROUP BY f1
  ORDER BY two, min_minus_1;
 two | max_plus_min | min_minus_1 
-----+--------------+-------------
(0 rows)

---END---
---START---
DROP TABLE TEMP_INT2;
---END---
---START---
DROP TABLE TEMP_INT4;
---END---
---START---
DROP TABLE TEMP_FLOAT;
---END---
---START---
DROP TABLE TEMP_GROUP;
---END---
