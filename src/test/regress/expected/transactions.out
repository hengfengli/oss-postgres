---START---
--
-- TRANSACTIONS
--
BEGIN;
---END---
---START---
CREATE TABLE xacttest (gemini_pk serial PRIMARY KEY, a smallint, b real);
---END---
---START---
INSERT INTO xacttest VALUES
  (56, 7.8),
  (100, 99.097),
  (0, 0.09561),
  (42, 324.78);
---END---
---START---
INSERT INTO xacttest (a, b) VALUES (777, 777.777);
---END---
---START---
END;
---END---
---START---
-- should retrieve one value--
SELECT a FROM xacttest WHERE a > 100;
  a  
-----
 325
 777
(2 rows)

---END---
---START---
BEGIN;
---END---
---START---
CREATE TABLE disappear (gemini_pk serial PRIMARY KEY, a int8);
---END---
---START---
DELETE FROM xacttest;
---END---
---START---
-- should be empty
SELECT * FROM xacttest;
 gemini_pk | a | b 
-----------+---+---
(0 rows)

---END---
---START---
ABORT;
---END---
---START---
-- should not exist
SELECT oid FROM pg_class WHERE relname = 'disappear';
 oid 
-----
(0 rows)

---END---
---START---
-- should have members again
SELECT * FROM xacttest;
 gemini_pk |  a  |    b    
-----------+-----+---------
        56 |   8 |        
       100 |  99 |        
         0 |   0 |        
        42 | 325 |        
         1 | 777 | 777.777
(5 rows)

---END---
---START---
-- Test that transaction characteristics cannot be reset.
BEGIN TRANSACTION ISOLATION LEVEL SERIALIZABLE;
---END---
---START---
SELECT COUNT(*) FROM xacttest;
 count 
-------
     5
(1 row)

---END---
---START---
RESET transaction_isolation;
ERROR:  parameter "transaction_isolation" cannot be reset
---END---
---START---
-- error
END;
---END---
---START---
BEGIN TRANSACTION READ ONLY;
---END---
---START---
SELECT COUNT(*) FROM xacttest;
 count 
-------
     5
(1 row)

---END---
---START---
RESET transaction_read_only;
ERROR:  parameter "transaction_read_only" cannot be reset
---END---
---START---
-- error
END;
---END---
---START---
BEGIN TRANSACTION DEFERRABLE;
---END---
---START---
SELECT COUNT(*) FROM xacttest;
 count 
-------
     5
(1 row)

---END---
---START---
RESET transaction_deferrable;
ERROR:  parameter "transaction_deferrable" cannot be reset
---END---
---START---
-- error
END;
---END---
---START---
CREATE FUNCTION errfunc() RETURNS int LANGUAGE SQL AS 'SELECT 1'
SET transaction_read_only = on;
ERROR:  parameter "transaction_read_only" cannot be set locally in functions
---END---
---START---
CREATE TABLE writetest (gemini_pk serial PRIMARY KEY, a integer);
---END---
---START---
DROP TABLE IF EXISTS temptest;
NOTICE:  table "temptest" does not exist, skipping
CREATE TABLE temptest (gemini_pk serial PRIMARY KEY, a integer);
---END---
---START---
BEGIN;
---END---
---START---
SET TRANSACTION ISOLATION LEVEL SERIALIZABLE, READ ONLY, DEFERRABLE;
---END---
---START---
-- ok
SELECT * FROM writetest;
 gemini_pk | a 
-----------+---
(0 rows)

---END---
---START---
-- ok
SET TRANSACTION READ WRITE;
ERROR:  transaction read-write mode must be set before any query
---END---
---START---
--fail
COMMIT;
---END---
---START---
BEGIN;
---END---
---START---
SET TRANSACTION READ ONLY;
---END---
---START---
-- ok
SET TRANSACTION READ WRITE;
---END---
---START---
-- ok
SET TRANSACTION READ ONLY;
---END---
---START---
-- ok
SELECT * FROM writetest;
 gemini_pk | a 
-----------+---
(0 rows)

---END---
---START---
-- ok
SAVEPOINT x;
---END---
---START---
SET TRANSACTION READ ONLY;
---END---
---START---
-- ok
SELECT * FROM writetest;
 gemini_pk | a 
-----------+---
(0 rows)

---END---
---START---
-- ok
SET TRANSACTION READ ONLY;
---END---
---START---
-- ok
SET TRANSACTION READ WRITE;
ERROR:  cannot set transaction read-write mode inside a read-only transaction
---END---
---START---
--fail
COMMIT;
---END---
---START---
BEGIN;
---END---
---START---
SET TRANSACTION READ WRITE;
---END---
---START---
-- ok
SAVEPOINT x;
---END---
---START---
SET TRANSACTION READ WRITE;
---END---
---START---
-- ok
SET TRANSACTION READ ONLY;
---END---
---START---
-- ok
SELECT * FROM writetest;
 gemini_pk | a 
-----------+---
(0 rows)

---END---
---START---
-- ok
SET TRANSACTION READ ONLY;
---END---
---START---
-- ok
SET TRANSACTION READ WRITE;
ERROR:  cannot set transaction read-write mode inside a read-only transaction
---END---
---START---
--fail
COMMIT;
---END---
---START---
BEGIN;
---END---
---START---
SET TRANSACTION READ WRITE;
---END---
---START---
-- ok
SAVEPOINT x;
---END---
---START---
SET TRANSACTION READ ONLY;
---END---
---START---
-- ok
SELECT * FROM writetest;
 gemini_pk | a 
-----------+---
(0 rows)

---END---
---START---
-- ok
ROLLBACK TO SAVEPOINT x;
---END---
---START---
SHOW transaction_read_only;
 transaction_read_only 
-----------------------
 off
(1 row)

---END---
---START---
-- off
SAVEPOINT y;
---END---
---START---
SET TRANSACTION READ ONLY;
---END---
---START---
-- ok
SELECT * FROM writetest;
 gemini_pk | a 
-----------+---
(0 rows)

---END---
---START---
-- ok
RELEASE SAVEPOINT y;
---END---
---START---
SHOW transaction_read_only;
 transaction_read_only 
-----------------------
 off
(1 row)

---END---
---START---
-- off
COMMIT;
---END---
---START---
SET SESSION CHARACTERISTICS AS TRANSACTION READ ONLY;
---END---
---START---
DROP TABLE writetest;
ERROR:  cannot execute DROP TABLE in a read-only transaction
---END---
---START---
-- fail
INSERT INTO writetest VALUES (1);
ERROR:  cannot execute INSERT in a read-only transaction
---END---
---START---
-- fail
SELECT * FROM writetest;
 gemini_pk | a 
-----------+---
(0 rows)

---END---
---START---
-- ok
DELETE FROM temptest;
ERROR:  cannot execute DELETE in a read-only transaction
---END---
---START---
-- ok
UPDATE temptest SET a = 0 FROM writetest WHERE temptest.a = 1 AND writetest.a = temptest.a;
ERROR:  cannot execute UPDATE in a read-only transaction
---END---
---START---
-- ok
PREPARE test AS UPDATE writetest SET a = 0;
---END---
---START---
-- ok
EXECUTE test;
ERROR:  cannot execute UPDATE in a read-only transaction
---END---
---START---
-- fail
SELECT * FROM writetest, temptest;
 gemini_pk | a | gemini_pk | a 
-----------+---+-----------+---
(0 rows)

---END---
---START---
-- ok
CREATE TABLE test AS SELECT * FROM writetest;
ERROR:  cannot execute CREATE TABLE AS in a read-only transaction
---END---
---START---
-- fail
START TRANSACTION READ WRITE;
---END---
---START---
DROP TABLE writetest;
---END---
---START---
-- ok
COMMIT;
---END---
---START---
-- Subtransactions, basic tests
-- create & drop tables
SET SESSION CHARACTERISTICS AS TRANSACTION READ WRITE;
---END---
---START---
CREATE TABLE trans_foobar (gemini_pk serial PRIMARY KEY, a integer);
---END---
---START---
BEGIN;
---END---
---START---
CREATE TABLE trans_foo (gemini_pk serial PRIMARY KEY, a integer);
---END---
---START---
SAVEPOINT one;
---END---
---START---
DROP TABLE trans_foo;
---END---
---START---
CREATE TABLE trans_bar (gemini_pk serial PRIMARY KEY, a integer);
---END---
---START---
ROLLBACK TO SAVEPOINT one;
---END---
---START---
RELEASE SAVEPOINT one;
---END---
---START---
SAVEPOINT two;
---END---
---START---
CREATE TABLE trans_baz (gemini_pk serial PRIMARY KEY, a integer);
---END---
---START---
RELEASE SAVEPOINT two;
---END---
---START---
drop TABLE trans_foobar;
---END---
---START---
CREATE TABLE trans_barbaz (gemini_pk serial PRIMARY KEY, a integer);
---END---
---START---
COMMIT;
---END---
---START---
-- should exist: trans_barbaz, trans_baz, trans_foo
SELECT * FROM trans_foo;
 gemini_pk | a 
-----------+---
(0 rows)

---END---
---START---
-- should be empty
SELECT * FROM trans_bar;
ERROR:  relation "trans_bar" does not exist
LINE 1: SELECT * FROM trans_bar;
                      ^
---END---
---START---
-- shouldn't exist
SELECT * FROM trans_barbaz;
 gemini_pk | a 
-----------+---
(0 rows)

---END---
---START---
-- should be empty
SELECT * FROM trans_baz;
 gemini_pk | a 
-----------+---
(0 rows)

---END---
---START---
-- should be empty
-- inserts
BEGIN;
---END---
---START---
INSERT INTO trans_foo VALUES (1);
---END---
---START---
SAVEPOINT one;
---END---
---START---
INSERT into trans_bar VALUES (1);
ERROR:  relation "trans_bar" does not exist
LINE 1: INSERT into trans_bar VALUES (1);
                    ^
---END---
---START---
ROLLBACK TO one;
---END---
---START---
RELEASE SAVEPOINT one;
---END---
---START---
SAVEPOINT two;
---END---
---START---
INSERT into trans_barbaz VALUES (1);
---END---
---START---
RELEASE two;
---END---
---START---
SAVEPOINT three;
---END---
---START---
SAVEPOINT four;
---END---
---START---
INSERT INTO trans_foo VALUES (2);
---END---
---START---
RELEASE SAVEPOINT four;
---END---
---START---
ROLLBACK TO SAVEPOINT three;
---END---
---START---
RELEASE SAVEPOINT three;
---END---
---START---
INSERT INTO trans_foo VALUES (3);
---END---
---START---
COMMIT;
---END---
---START---
SELECT * FROM trans_foo;
 gemini_pk | a 
-----------+---
         1 |  
         3 |  
(2 rows)

---END---
---START---
-- should have 1 and 3
SELECT * FROM trans_barbaz;
 gemini_pk | a 
-----------+---
         1 |  
(1 row)

---END---
---START---
-- should have 1
-- test whole-tree commit
BEGIN;
---END---
---START---
SAVEPOINT one;
---END---
---START---
SELECT trans_foo;
ERROR:  column "trans_foo" does not exist
LINE 1: SELECT trans_foo;
               ^
---END---
---START---
ROLLBACK TO SAVEPOINT one;
---END---
---START---
RELEASE SAVEPOINT one;
---END---
---START---
SAVEPOINT two;
---END---
---START---
CREATE TABLE savepoints (gemini_pk serial PRIMARY KEY, a integer);
---END---
---START---
SAVEPOINT three;
---END---
---START---
INSERT INTO savepoints VALUES (1);
---END---
---START---
SAVEPOINT four;
---END---
---START---
INSERT INTO savepoints VALUES (2);
---END---
---START---
SAVEPOINT five;
---END---
---START---
INSERT INTO savepoints VALUES (3);
---END---
---START---
ROLLBACK TO SAVEPOINT five;
---END---
---START---
COMMIT;
---END---
---START---
COMMIT;
WARNING:  there is no transaction in progress
---END---
---START---
-- should not be in a transaction block
SELECT * FROM savepoints;
 gemini_pk | a 
-----------+---
         1 |  
         2 |  
(2 rows)

---END---
---START---
-- test whole-tree rollback
BEGIN;
---END---
---START---
SAVEPOINT one;
---END---
---START---
DELETE FROM savepoints WHERE a=1;
---END---
---START---
RELEASE SAVEPOINT one;
---END---
---START---
SAVEPOINT two;
---END---
---START---
DELETE FROM savepoints WHERE a=1;
---END---
---START---
SAVEPOINT three;
---END---
---START---
DELETE FROM savepoints WHERE a=2;
---END---
---START---
ROLLBACK;
---END---
---START---
COMMIT;
WARNING:  there is no transaction in progress
---END---
---START---
-- should not be in a transaction block
SELECT * FROM savepoints;
 gemini_pk | a 
-----------+---
         1 |  
         2 |  
(2 rows)

---END---
---START---
-- test whole-tree commit on an aborted subtransaction
BEGIN;
---END---
---START---
INSERT INTO savepoints VALUES (4);
---END---
---START---
SAVEPOINT one;
---END---
---START---
INSERT INTO savepoints VALUES (5);
---END---
---START---
SELECT trans_foo;
ERROR:  column "trans_foo" does not exist
LINE 1: SELECT trans_foo;
               ^
---END---
---START---
COMMIT;
---END---
---START---
SELECT * FROM savepoints;
 gemini_pk | a 
-----------+---
         1 |  
         2 |  
(2 rows)

---END---
---START---
BEGIN;
---END---
---START---
INSERT INTO savepoints VALUES (6);
---END---
---START---
SAVEPOINT one;
---END---
---START---
INSERT INTO savepoints VALUES (7);
---END---
---START---
RELEASE SAVEPOINT one;
---END---
---START---
INSERT INTO savepoints VALUES (8);
---END---
---START---
COMMIT;
---END---
---START---
-- rows 6 and 8 should have been created by the same xact
SELECT a.xmin = b.xmin FROM savepoints a, savepoints b WHERE a.a=6 AND b.a=8;
 ?column? 
----------
(0 rows)

---END---
---START---
-- rows 6 and 7 should have been created by different xacts
SELECT a.xmin = b.xmin FROM savepoints a, savepoints b WHERE a.a=6 AND b.a=7;
 ?column? 
----------
(0 rows)

---END---
---START---
BEGIN;
---END---
---START---
INSERT INTO savepoints VALUES (9);
---END---
---START---
SAVEPOINT one;
---END---
---START---
INSERT INTO savepoints VALUES (10);
---END---
---START---
ROLLBACK TO SAVEPOINT one;
---END---
---START---
INSERT INTO savepoints VALUES (11);
---END---
---START---
COMMIT;
---END---
---START---
SELECT a FROM savepoints WHERE a in (9, 10, 11);
 a 
---
(0 rows)

---END---
---START---
-- rows 9 and 11 should have been created by different xacts
SELECT a.xmin = b.xmin FROM savepoints a, savepoints b WHERE a.a=9 AND b.a=11;
 ?column? 
----------
(0 rows)

---END---
---START---
BEGIN;
---END---
---START---
INSERT INTO savepoints VALUES (12);
---END---
---START---
SAVEPOINT one;
---END---
---START---
INSERT INTO savepoints VALUES (13);
---END---
---START---
SAVEPOINT two;
---END---
---START---
INSERT INTO savepoints VALUES (14);
---END---
---START---
ROLLBACK TO SAVEPOINT one;
---END---
---START---
INSERT INTO savepoints VALUES (15);
---END---
---START---
SAVEPOINT two;
---END---
---START---
INSERT INTO savepoints VALUES (16);
---END---
---START---
SAVEPOINT three;
---END---
---START---
INSERT INTO savepoints VALUES (17);
---END---
---START---
COMMIT;
---END---
---START---
SELECT a FROM savepoints WHERE a BETWEEN 12 AND 17;
 a 
---
(0 rows)

---END---
---START---
BEGIN;
---END---
---START---
INSERT INTO savepoints VALUES (18);
---END---
---START---
SAVEPOINT one;
---END---
---START---
INSERT INTO savepoints VALUES (19);
---END---
---START---
SAVEPOINT two;
---END---
---START---
INSERT INTO savepoints VALUES (20);
---END---
---START---
ROLLBACK TO SAVEPOINT one;
---END---
---START---
INSERT INTO savepoints VALUES (21);
---END---
---START---
ROLLBACK TO SAVEPOINT one;
