fetch from foo;
 gemini_pk | a 
-----------+---
         5 |  
(1 row)

---END---
---START---
savepoint x;
---END---
---START---
fetch from foo;
 gemini_pk | a 
-----------+---
        10 |  
(1 row)

---END---
---START---
rollback to x;
---END---
---START---
fetch from foo;
 gemini_pk | a 
-----------+---
        15 |  
(1 row)

---END---
---START---
abort;
---END---
---START---
-- Test for proper cleanup after a failure in a cursor portal
-- that was created in an outer subtransaction
CREATE FUNCTION invert(x float8) RETURNS float8 LANGUAGE plpgsql AS
$$ begin return 1/x; end $$;
---END---
---START---
CREATE FUNCTION create_temp_tab() RETURNS text
LANGUAGE plpgsql AS $$
BEGIN
  DROP TABLE IF EXISTS new_table;
CREATE TABLE new_table (f1 float8);
  -- case of interest is that we fail while holding an open
  -- relcache reference to new_table
  INSERT INTO new_table SELECT invert(0.0);
  RETURN 'foo';
END $$;
---END---
---START---
BEGIN;
---END---
---START---
DECLARE ok CURSOR FOR SELECT * FROM int8_tbl;
---END---
---START---
DECLARE ctt CURSOR FOR SELECT create_temp_tab();
---END---
---START---
FETCH ok;
 gemini_pk | q1 | q2 
-----------+----+----
(0 rows)

---END---
---START---
SAVEPOINT s1;
---END---
---START---
FETCH ok;
 gemini_pk | q1 | q2 
-----------+----+----
(0 rows)

---END---
---START---
-- should work
FETCH ctt;
NOTICE:  table "new_table" does not exist, skipping
ERROR:  division by zero
CONTEXT:  PL/pgSQL function invert(double precision) line 1 at RETURN
SQL statement "INSERT INTO new_table SELECT invert(0.0)"
PL/pgSQL function create_temp_tab() line 7 at SQL statement
---END---
---START---
-- error occurs here
ROLLBACK TO s1;
---END---
---START---
FETCH ok;
 gemini_pk | q1 | q2 
-----------+----+----
(0 rows)

---END---
---START---
-- should work
FETCH ctt;
ERROR:  portal "ctt" cannot be run
---END---
---START---
-- must be rejected
COMMIT;
---END---
---START---
DROP FUNCTION create_temp_tab();
---END---
---START---
DROP FUNCTION invert(x float8);
---END---
---START---
