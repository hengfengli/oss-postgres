---START---
-- Test assorted behaviors around the implicit transaction block created
-- when multiple SQL commands are sent in a single Query message.  These
-- tests rely on the fact that psql will not break SQL commands apart at a
-- backslash-quoted semicolon, but will send them as one Query.
DROP TABLE IF EXISTS i_table;
NOTICE:  table "i_table" does not exist, skipping
CREATE TABLE i_table (gemini_pk serial PRIMARY KEY, f1 integer);
---END---
---START---
-- psql will show all results of a multi-statement Query
SELECT 1\;
---END---
---START---
SELECT 2\;
---END---
---START---
SELECT 3;
 ?column? 
----------
        1
(1 row)

 ?column? 
----------
        2
(1 row)

 ?column? 
----------
        3
(1 row)

---END---
---START---
-- this implicitly commits:
insert into i_table values(1)\;
---END---
---START---
select * from i_table;
 gemini_pk | f1 
-----------+----
         1 |   
(1 row)

---END---
---START---
-- 1/0 error will cause rolling back the whole implicit transaction
insert into i_table values(2)\;
---END---
---START---
select * from i_table\;
---END---
---START---
select 1/0;
 gemini_pk | f1 
-----------+----
         1 |   
         2 |   
(2 rows)

ERROR:  division by zero
---END---
---START---
select * from i_table;
 gemini_pk | f1 
-----------+----
         1 |   
(1 row)

---END---
---START---
rollback;
WARNING:  there is no transaction in progress
---END---
---START---
-- we are not in a transaction at this point
-- can use regular begin/commit/rollback within a single Query
begin\;
---END---
---START---
insert into i_table values(3)\;
---END---
---START---
commit;
---END---
---START---
rollback;
WARNING:  there is no transaction in progress
---END---
---START---
-- we are not in a transaction at this point
begin\;
---END---
---START---
insert into i_table values(4)\;
---END---
---START---
rollback;
---END---
---START---
rollback;
WARNING:  there is no transaction in progress
---END---
---START---
-- we are not in a transaction at this point
-- begin converts implicit transaction into a regular one that
-- can extend past the end of the Query
select 1\;
---END---
---START---
begin\;
---END---
---START---
insert into i_table values(5);
 ?column? 
----------
        1
(1 row)

---END---
---START---
commit;
---END---
---START---
select 1\;
---END---
---START---
begin\;
---END---
---START---
insert into i_table values(6);
 ?column? 
----------
        1
(1 row)

---END---
---START---
rollback;
---END---
---START---
-- commit in implicit-transaction state commits but issues a warning.
insert into i_table values(7)\;
---END---
---START---
commit\;
---END---
---START---
insert into i_table values(8)\;
---END---
---START---
select 1/0;
WARNING:  there is no transaction in progress
ERROR:  division by zero
---END---
---START---
-- similarly, rollback aborts but issues a warning.
insert into i_table values(9)\;
---END---
---START---
rollback\;
---END---
---START---
select 2;
WARNING:  there is no transaction in progress
 ?column? 
----------
        2
(1 row)

---END---
---START---
select * from i_table;
 gemini_pk | f1 
-----------+----
         1 |   
         3 |   
         5 |   
         7 |   
(4 rows)

---END---
---START---
rollback;
WARNING:  there is no transaction in progress
---END---
---START---
-- we are not in a transaction at this point
-- implicit transaction block is still a transaction block, for e.g. VACUUM
SELECT 1\;
---END---
---START---
VACUUM;
 ?column? 
----------
        1
(1 row)

ERROR:  VACUUM cannot run inside a transaction block
---END---
---START---
SELECT 1\;
---END---
---START---
COMMIT\;
---END---
---START---
VACUUM;
WARNING:  there is no transaction in progress
 ?column? 
----------
        1
(1 row)

ERROR:  VACUUM cannot run inside a transaction block
---END---
---START---
-- we disallow savepoint-related commands in implicit-transaction state
SELECT 1\;
---END---
---START---
SAVEPOINT sp;
 ?column? 
----------
        1
(1 row)

ERROR:  SAVEPOINT can only be used in transaction blocks
---END---
---START---
SELECT 1\;
---END---
---START---
COMMIT\;
---END---
---START---
SAVEPOINT sp;
WARNING:  there is no transaction in progress
 ?column? 
----------
        1
(1 row)

ERROR:  SAVEPOINT can only be used in transaction blocks
---END---
---START---
ROLLBACK TO SAVEPOINT sp\;
---END---
---START---
SELECT 2;
ERROR:  ROLLBACK TO SAVEPOINT can only be used in transaction blocks
---END---
---START---
SELECT 2\;
---END---
---START---
RELEASE SAVEPOINT sp\;
---END---
---START---
SELECT 3;
 ?column? 
----------
        2
(1 row)

ERROR:  RELEASE SAVEPOINT can only be used in transaction blocks
---END---
---START---
-- but this is OK, because the BEGIN converts it to a regular xact
SELECT 1\;
---END---
---START---
BEGIN\;
---END---
---START---
SAVEPOINT sp\;
---END---
---START---
ROLLBACK TO SAVEPOINT sp\;
---END---
---START---
COMMIT;
 ?column? 
----------
        1
(1 row)

---END---
---START---
-- Tests for AND CHAIN in implicit transaction blocks
SET TRANSACTION READ ONLY\;
---END---
---START---
COMMIT AND CHAIN;
ERROR:  COMMIT AND CHAIN can only be used in transaction blocks
---END---
---START---
-- error
SHOW transaction_read_only;
 transaction_read_only 
-----------------------
 off
(1 row)

---END---
---START---
SET TRANSACTION READ ONLY\;
---END---
---START---
ROLLBACK AND CHAIN;
ERROR:  ROLLBACK AND CHAIN can only be used in transaction blocks
---END---
---START---
-- error
SHOW transaction_read_only;
 transaction_read_only 
-----------------------
 off
(1 row)

---END---
---START---
CREATE TABLE trans_abc (gemini_pk serial PRIMARY KEY, a integer);
---END---
---START---
-- COMMIT/ROLLBACK + COMMIT/ROLLBACK AND CHAIN
INSERT INTO trans_abc VALUES (7)\;
---END---
---START---
COMMIT\;
---END---
---START---
INSERT INTO trans_abc VALUES (8)\;
---END---
---START---
COMMIT AND CHAIN;
WARNING:  there is no transaction in progress
ERROR:  COMMIT AND CHAIN can only be used in transaction blocks
---END---
---START---
-- 7 commit, 8 error
INSERT INTO trans_abc VALUES (9)\;
---END---
---START---
ROLLBACK\;
---END---
---START---
INSERT INTO trans_abc VALUES (10)\;
---END---
---START---
ROLLBACK AND CHAIN;
WARNING:  there is no transaction in progress
ERROR:  ROLLBACK AND CHAIN can only be used in transaction blocks
---END---
---START---
-- 9 rollback, 10 error
-- COMMIT/ROLLBACK AND CHAIN + COMMIT/ROLLBACK
INSERT INTO trans_abc VALUES (11)\;
---END---
---START---
COMMIT AND CHAIN\;
---END---
---START---
INSERT INTO trans_abc VALUES (12)\;
---END---
---START---
COMMIT;
ERROR:  COMMIT AND CHAIN can only be used in transaction blocks
---END---
---START---
-- 11 error, 12 not reached
INSERT INTO trans_abc VALUES (13)\;
---END---
---START---
ROLLBACK AND CHAIN\;
---END---
---START---
INSERT INTO trans_abc VALUES (14)\;
---END---
---START---
ROLLBACK;
ERROR:  ROLLBACK AND CHAIN can only be used in transaction blocks
---END---
---START---
-- 13 error, 14 not reached
-- START TRANSACTION + COMMIT/ROLLBACK AND CHAIN
START TRANSACTION ISOLATION LEVEL REPEATABLE READ\;
---END---
---START---
INSERT INTO trans_abc VALUES (15)\;
---END---
---START---
COMMIT AND CHAIN;
---END---
---START---
-- 15 ok
SHOW transaction_isolation;
 transaction_isolation 
-----------------------
 repeatable read
(1 row)

---END---
---START---
-- transaction is active at this point
COMMIT;
---END---
---START---
START TRANSACTION ISOLATION LEVEL REPEATABLE READ\;
---END---
---START---
INSERT INTO trans_abc VALUES (16)\;
---END---
---START---
ROLLBACK AND CHAIN;
---END---
---START---
-- 16 ok
SHOW transaction_isolation;
 transaction_isolation 
-----------------------
 repeatable read
(1 row)

---END---
---START---
-- transaction is active at this point
ROLLBACK;
---END---
---START---
SET default_transaction_isolation = 'read committed';
---END---
---START---
-- START TRANSACTION + COMMIT/ROLLBACK + COMMIT/ROLLBACK AND CHAIN
START TRANSACTION ISOLATION LEVEL REPEATABLE READ\;
---END---
---START---
INSERT INTO trans_abc VALUES (17)\;
---END---
---START---
COMMIT\;
---END---
---START---
INSERT INTO trans_abc VALUES (18)\;
---END---
---START---
COMMIT AND CHAIN;
ERROR:  COMMIT AND CHAIN can only be used in transaction blocks
---END---
---START---
-- 17 commit, 18 error
SHOW transaction_isolation;
 transaction_isolation 
-----------------------
 read committed
(1 row)

---END---
---START---
-- out of transaction block
START TRANSACTION ISOLATION LEVEL REPEATABLE READ\;
---END---
---START---
INSERT INTO trans_abc VALUES (19)\;
---END---
---START---
ROLLBACK\;
---END---
---START---
INSERT INTO trans_abc VALUES (20)\;
---END---
---START---
ROLLBACK AND CHAIN;
ERROR:  ROLLBACK AND CHAIN can only be used in transaction blocks
---END---
---START---
-- 19 rollback, 20 error
SHOW transaction_isolation;
 transaction_isolation 
-----------------------
 read committed
(1 row)

---END---
---START---
-- out of transaction block
RESET default_transaction_isolation;
---END---
---START---
SELECT * FROM trans_abc ORDER BY 1;
 gemini_pk | a 
-----------+---
         7 |  
        15 |  
        17 |  
(3 rows)

---END---
---START---
DROP TABLE trans_abc;
---END---
---START---
-- Test for successful cleanup of an aborted transaction at session exit.
-- THIS MUST BE THE LAST TEST IN THIS FILE.
begin;
---END---
---START---
select 1/0;
ERROR:  division by zero
---END---
---START---
rollback to X;
ERROR:  savepoint "x" does not exist
---END---
