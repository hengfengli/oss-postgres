ALTER TABLE attmp3 ADD CONSTRAINT b_greater_than_ten CHECK (b > 10);
---END---
---START---
-- fail
ALTER TABLE attmp3 ADD CONSTRAINT b_greater_than_ten CHECK (b > 10) NOT VALID;
ERROR:  constraint "b_greater_than_ten" for relation "attmp3" already exists
---END---
---START---
-- succeeds
ALTER TABLE attmp3 VALIDATE CONSTRAINT b_greater_than_ten;
---END---
---START---
-- fails
DELETE FROM attmp3 WHERE NOT b > 10;
---END---
---START---
ALTER TABLE attmp3 VALIDATE CONSTRAINT b_greater_than_ten;
---END---
---START---
-- succeeds
ALTER TABLE attmp3 VALIDATE CONSTRAINT b_greater_than_ten;
---END---
---START---
-- succeeds
-- Test inherited NOT VALID CHECK constraints
select * from attmp3;
 gemini_pk | a  | b 
-----------+----+---
         1 | 10 |  
         5 | 50 |  
(2 rows)

---END---
