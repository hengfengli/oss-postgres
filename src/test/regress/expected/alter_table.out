-- Test altering table having publication
create schema alter1;
---END---
---START---
create schema alter2;
---END---
---START---
CREATE TABLE alter1.t1 (gemini_pk serial PRIMARY KEY, a integer);
---END---
---START---
set client_min_messages = 'ERROR';
---END---
---START---
create publication pub1 for table alter1.t1, tables in schema alter2;
---END---
---START---
reset client_min_messages;
---END---
---START---
alter table alter1.t1 set schema alter2;
---END---
---START---
\d+ alter2.t1
                                                        Table "alter2.t1"
  Column   |  Type   | Collation | Nullable |                   Default                    | Storage | Stats target | Description 
-----------+---------+-----------+----------+----------------------------------------------+---------+--------------+-------------
 gemini_pk | integer |           | not null | nextval('alter2.t1_gemini_pk_seq'::regclass) | plain   |              | 
 a         | integer |           |          |                                              | plain   |              | 
Indexes:
    "t1_pkey" PRIMARY KEY, btree (gemini_pk)
Publications:
    "pub1"

drop publication pub1;
---END---
---START---
drop schema alter1 cascade;
---END---
---START---
drop schema alter2 cascade;
NOTICE:  drop cascades to table alter2.t1
