---START---
DROP TABLE IF EXISTS rows;
NOTICE:  table "rows" does not exist, skipping
CREATE TABLE rows AS
SELECT x, 'txt' || x as y
FROM generate_series(1,3) AS x;
---END---
---START---
SELECT row_to_json(q,true)
FROM rows q;
 row_to_json  
--------------
 {"x":1,     +
  "y":"txt1"}
 {"x":2,     +
  "y":"txt2"}
 {"x":3,     +
  "y":"txt3"}
(3 rows)

---END---
