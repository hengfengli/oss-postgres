                                           ^
---END---
---START---
--
-- Test that expression-index constraints can be pushed down through
-- UNION or UNION ALL
--
DROP TABLE IF EXISTS t1;
ERROR:  cannot drop table t1 because other objects depend on it
DETAIL:  constraint t2_b_fkey on table t2 depends on table t1
HINT:  Use DROP ... CASCADE to drop the dependent objects too.
CREATE TABLE t1 (gemini_pk serial PRIMARY KEY, a text, b text);
ERROR:  relation "t1" already exists
---END---
---START---
CREATE INDEX t1_ab_idx on t1 ((a || b));
---END---
---START---
DROP TABLE IF EXISTS t2;
ERROR:  cannot drop table t2 because other objects depend on it
DETAIL:  rule r1 on table t1 depends on table t2
table t2a depends on table t2
HINT:  Use DROP ... CASCADE to drop the dependent objects too.
CREATE TABLE t2 (ab text primary key);
ERROR:  relation "t2" already exists
---END---
---START---
INSERT INTO t1 VALUES ('a', 'b'), ('x', 'y');
ERROR:  invalid input syntax for type integer: "a"
LINE 1: INSERT INTO t1 VALUES ('a', 'b'), ('x', 'y');
                               ^
---END---
---START---
INSERT INTO t2 VALUES ('ab'), ('xy');
ERROR:  invalid input syntax for type integer: "ab"
LINE 1: INSERT INTO t2 VALUES ('ab'), ('xy');
                               ^
---END---
---START---
set enable_seqscan = off;
---END---
---START---
set enable_indexscan = on;
---END---
---START---
set enable_bitmapscan = off;
---END---
---START---
explain (costs off)
 SELECT * FROM
 (SELECT a || b AS ab FROM t1
  UNION ALL
  SELECT * FROM t2) t
 WHERE ab = 'ab';
ERROR:  each UNION query must have the same number of columns
LINE 5:   SELECT * FROM t2) t
                 ^
---END---
---START---
explain (costs off)
 SELECT * FROM
 (SELECT a || b AS ab FROM t1
  UNION
  SELECT * FROM t2) t
 WHERE ab = 'ab';
ERROR:  each UNION query must have the same number of columns
LINE 5:   SELECT * FROM t2) t
                 ^
---END---
---START---
--
-- Test that ORDER BY for UNION ALL can be pushed down to inheritance
-- children.
--
DROP TABLE IF EXISTS t1c;
NOTICE:  table "t1c" does not exist, skipping
CREATE TABLE t1c (gemini_pk serial PRIMARY KEY, b text, a text);
---END---
---START---
ALTER TABLE t1c INHERIT t1;
ERROR:  child table "t1c" has different type for column "a"
---END---
---START---
DROP TABLE IF EXISTS t2c;
NOTICE:  table "t2c" does not exist, skipping
CREATE TABLE t2c (primary key (ab)) INHERITS (t2);
ERROR:  column "ab" named in key does not exist
LINE 1: CREATE TABLE t2c (primary key (ab)) INHERITS (t2);
                          ^
---END---
---START---
INSERT INTO t1c VALUES ('v', 'w'), ('c', 'd'), ('m', 'n'), ('e', 'f');
ERROR:  invalid input syntax for type integer: "v"
LINE 1: INSERT INTO t1c VALUES ('v', 'w'), ('c', 'd'), ('m', 'n'), (...
                                ^
---END---
---START---
INSERT INTO t2c VALUES ('vw'), ('cd'), ('mn'), ('ef');
ERROR:  relation "t2c" does not exist
LINE 1: INSERT INTO t2c VALUES ('vw'), ('cd'), ('mn'), ('ef');
                    ^
---END---
---START---
CREATE INDEX t1c_ab_idx on t1c ((a || b));
---END---
---START---
set enable_seqscan = on;
---END---
---START---
set enable_indexonlyscan = off;
---END---
---START---
explain (costs off)
  SELECT * FROM
  (SELECT a || b AS ab FROM t1
   UNION ALL
   SELECT ab FROM t2) t
  ORDER BY 1 LIMIT 8;
ERROR:  column "ab" does not exist
LINE 5:    SELECT ab FROM t2) t
                  ^
DETAIL:  There is a column named "ab" in table "*SELECT* 1", but it cannot be referenced from this part of the query.
---END---
---START---
SELECT * FROM
  (SELECT a || b AS ab FROM t1
   UNION ALL
   SELECT ab FROM t2) t
  ORDER BY 1 LIMIT 8;
ERROR:  column "ab" does not exist
LINE 4:    SELECT ab FROM t2) t
                  ^
DETAIL:  There is a column named "ab" in table "*SELECT* 1", but it cannot be referenced from this part of the query.
---END---
---START---
reset enable_seqscan;
---END---
---START---
reset enable_indexscan;
---END---
---START---
reset enable_bitmapscan;
---END---
---START---
-- This simpler variant of the above test has been observed to fail differently
create table events (event_id int primary key);
---END---
---START---
create table other_events (event_id int primary key);
---END---
---START---
CREATE TABLE events_child (gemini_pk serial PRIMARY KEY) INHERITS (events);
---END---
---START---
explain (costs off)
select event_id
 from (select event_id from events
       union all
       select event_id from other_events) ss
 order by event_id;
                        QUERY PLAN                        
----------------------------------------------------------
 Merge Append
   Sort Key: events.event_id
   ->  Index Scan using events_pkey on events
   ->  Sort
         Sort Key: events_1.event_id
         ->  Seq Scan on events_child events_1
   ->  Index Scan using other_events_pkey on other_events
(7 rows)

---END---
---START---
drop table events_child, events, other_events;
---END---
---START---
reset enable_indexonlyscan;
---END---
