   ->  Subquery Scan on ss
         ->  SetOp Intersect
               ->  Sort
                     Sort Key: "*SELECT* 1".unique1
                     ->  Append
                           ->  Subquery Scan on "*SELECT* 1"
                                 ->  Seq Scan on tenk1
                           ->  Subquery Scan on "*SELECT* 2"
                                 ->  Seq Scan on tenk1 tenk1_1
(10 rows)

---END---
---START---
select count(*) from
  ( select unique1 from tenk1 intersect select fivethous from tenk1 ) ss;
