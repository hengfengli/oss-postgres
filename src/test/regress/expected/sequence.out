---START---
--
-- Check dependencies of serial and ordinary sequences
--
CREATE TEMP SEQUENCE myseq2;
---END---
---START---
CREATE TEMP SEQUENCE myseq3;
---END---
---START---
DROP TABLE IF EXISTS t1;
ERROR:  cannot drop table t1 because other objects depend on it
DETAIL:  constraint t2_b_fkey on table t2 depends on table t1
HINT:  Use DROP ... CASCADE to drop the dependent objects too.
CREATE TABLE t1 (gemini_pk serial PRIMARY KEY, f1 serial, f2 integer DEFAULT nextval('myseq2'), f3 integer DEFAULT nextval(CAST('myseq3' AS text)));
ERROR:  relation "t1" already exists
---END---
---START---
-- Both drops should fail, but with different error messages:
DROP SEQUENCE t1_f1_seq;
ERROR:  sequence "t1_f1_seq" does not exist
---END---
---START---
DROP SEQUENCE myseq2;
---END---
---START---
-- This however will work:
DROP SEQUENCE myseq3;
---END---
---START---
DROP TABLE t1;
ERROR:  cannot drop table t1 because other objects depend on it
DETAIL:  constraint t2_b_fkey on table t2 depends on table t1
HINT:  Use DROP ... CASCADE to drop the dependent objects too.
---END---
---START---
-- Fails because no longer existent:
DROP SEQUENCE t1_f1_seq;
ERROR:  sequence "t1_f1_seq" does not exist
---END---
---START---
-- Now OK:
DROP SEQUENCE myseq2;
ERROR:  sequence "myseq2" does not exist
---END---
---START---
--
-- Alter sequence
--
ALTER SEQUENCE IF EXISTS sequence_test2 RESTART WITH 24
  INCREMENT BY 4 MAXVALUE 36 MINVALUE 5 CYCLE;
NOTICE:  relation "sequence_test2" does not exist, skipping
---END---
---START---
ALTER SEQUENCE serialTest1 CYCLE;
ERROR:  "serialtest1" is not a sequence
---END---
---START---
-- error, not a sequence
CREATE SEQUENCE sequence_test2 START WITH 32;
---END---
