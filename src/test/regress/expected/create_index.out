---START---
CREATE INDEX gpointind ON point_tbl USING gist (f1);
ERROR:  relation "point_tbl" does not exist
---END---
---START---
DROP TABLE IF EXISTS gpolygon_tbl;
NOTICE:  table "gpolygon_tbl" does not exist, skipping
CREATE TABLE gpolygon_tbl AS
    SELECT polygon(home_base) AS f1 FROM slow_emp4000;
---END---
---START---
INSERT INTO gpolygon_tbl VALUES ( '(1000,0,0,1000)' );
---END---
---START---
INSERT INTO gpolygon_tbl VALUES ( '(0,1000,1000,1000)' );
---END---
---START---
DROP TABLE IF EXISTS gcircle_tbl;
NOTICE:  table "gcircle_tbl" does not exist, skipping
CREATE TABLE gcircle_tbl AS
    SELECT circle(home_base) AS f1 FROM slow_emp4000;
---END---
---START---
CREATE INDEX ggpolygonind ON gpolygon_tbl USING gist (f1);
---END---
---START---
CREATE INDEX ggcircleind ON gcircle_tbl USING gist (f1);
---END---
