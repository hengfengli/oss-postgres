---END---
---START---
ANALYZE slow_emp4000;
---END---
---START---
ANALYZE fast_emp4000;
---END---
---START---
CREATE INDEX grect2ind ON fast_emp4000 USING gist (home_base);
---END---
---START---
-- we want to work with a point_tbl that includes a null
DROP TABLE IF EXISTS point_tbl;
NOTICE:  table "point_tbl" does not exist, skipping
CREATE TABLE point_tbl AS SELECT * FROM public.point_tbl;
ERROR:  relation "public.point_tbl" does not exist
LINE 1: CREATE TABLE point_tbl AS SELECT * FROM public.point_tbl;
