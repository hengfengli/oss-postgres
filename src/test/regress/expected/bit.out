---START---
CREATE TABLE bit_defaults (gemini_pk serial PRIMARY KEY, b1 pg_catalog.bit(4) DEFAULT '1001', b2 pg_catalog.bit(4) DEFAULT b'0101', b3 bit varying(5) DEFAULT '1001', b4 bit varying(5) DEFAULT b'0101');
---END---
---START---
\d bit_defaults
                                     Table "public.bit_defaults"
  Column   |      Type      | Collation | Nullable |                     Default                     
-----------+----------------+-----------+----------+-------------------------------------------------
 gemini_pk | integer        |           | not null | nextval('bit_defaults_gemini_pk_seq'::regclass)
 b1        | bit(4)         |           |          | '1001'::"bit"
 b2        | bit(4)         |           |          | '0101'::"bit"
 b3        | bit varying(5) |           |          | '1001'::bit varying
 b4        | bit varying(5) |           |          | '0101'::"bit"
Indexes:
    "bit_defaults_pkey" PRIMARY KEY, btree (gemini_pk)

INSERT INTO bit_defaults DEFAULT VALUES;
---END---
