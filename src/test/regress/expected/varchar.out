---START---
CREATE TABLE varchar_tbl_temp (gemini_pk serial PRIMARY KEY, f1 varchar(1));
---END---
---START---
INSERT INTO VARCHAR_TBL_TEMP (f1) VALUES ('a');
---END---
---START---
INSERT INTO VARCHAR_TBL_TEMP (f1) VALUES ('A');
---END---
---START---
-- any of the following three input formats are acceptable
INSERT INTO VARCHAR_TBL_TEMP (f1) VALUES ('1');
---END---
---START---
INSERT INTO VARCHAR_TBL_TEMP (f1) VALUES (2);
---END---
---START---
INSERT INTO VARCHAR_TBL_TEMP (f1) VALUES ('3');
---END---
---START---
-- zero-length char
INSERT INTO VARCHAR_TBL_TEMP (f1) VALUES ('');
---END---
---START---
-- try varchar's of greater than 1 length
INSERT INTO VARCHAR_TBL_TEMP (f1) VALUES ('cd');
ERROR:  value too long for type character varying(1)
---END---
---START---
INSERT INTO VARCHAR_TBL_TEMP (f1) VALUES ('c     ');
---END---
---START---
SELECT * FROM VARCHAR_TBL_TEMP;
 gemini_pk | f1 
-----------+----
         1 | a
         2 | A
         3 | 1
         4 | 2
         5 | 3
         6 | 
         7 | c
(7 rows)

---END---
---START---
SELECT c.*
   FROM VARCHAR_TBL_TEMP c
   WHERE c.f1 <> 'a';
 gemini_pk | f1 
-----------+----
         2 | A
         3 | 1
         4 | 2
         5 | 3
         6 | 
         7 | c
(6 rows)

---END---
---START---
SELECT c.*
   FROM VARCHAR_TBL_TEMP c
   WHERE c.f1 = 'a';
 gemini_pk | f1 
-----------+----
         1 | a
(1 row)

---END---
---START---
SELECT c.*
   FROM VARCHAR_TBL_TEMP c
   WHERE c.f1 < 'a';
 gemini_pk | f1 
-----------+----
         2 | A
         3 | 1
         4 | 2
         5 | 3
         6 | 
(5 rows)

---END---
---START---
SELECT c.*
   FROM VARCHAR_TBL_TEMP c
   WHERE c.f1 <= 'a';
 gemini_pk | f1 
-----------+----
         1 | a
         2 | A
         3 | 1
         4 | 2
         5 | 3
         6 | 
(6 rows)

---END---
---START---
SELECT c.*
   FROM VARCHAR_TBL_TEMP c
   WHERE c.f1 > 'a';
 gemini_pk | f1 
-----------+----
         7 | c
(1 row)

---END---
---START---
SELECT c.*
   FROM VARCHAR_TBL_TEMP c
   WHERE c.f1 >= 'a';
 gemini_pk | f1 
-----------+----
         1 | a
         7 | c
(2 rows)

---END---
---START---
DROP TABLE VARCHAR_TBL_TEMP;
---END---
---START---
--
-- Now test longer arrays of char
--
-- This varchar_tbl_TEMP was already created and filled in test_setup.sql.
-- Here we just try to insert bad values.
--
INSERT INTO VARCHAR_TBL (f1) VALUES ('abcde');
ERROR:  value too long for type character varying(4)
---END---
---START---
SELECT * FROM VARCHAR_TBL;
 gemini_pk |  f1  
-----------+------
         1 | a
         2 | ab
         3 | abcd
         4 | abcd
(4 rows)

---END---
---START---
-- Also try it with non-error-throwing API
SELECT pg_input_is_valid('abcd  ', 'varchar(4)');
 pg_input_is_valid 
-------------------
 t
(1 row)

---END---
---START---
SELECT pg_input_is_valid('abcde', 'varchar(4)');
 pg_input_is_valid 
-------------------
 f
(1 row)

---END---
---START---
SELECT * FROM pg_input_error_info('abcde', 'varchar(4)');
                   message                    | detail | hint | sql_error_code 
----------------------------------------------+--------+------+----------------
 value too long for type character varying(4) |        |      | 22001
(1 row)

---END---
