---START---
--
-- ARRAYS
--
-- directory paths are passed to us in environment variables
\getenv abs_srcdir PG_ABS_SRCDIR
CREATE TABLE arrtest (
	a 			int8[],
	b 			int8[][][],
	c 			text[],
	d			text[][],
	e 			float8[],
	f			varchar(5)[],
	g			varchar(5)[]
);
---END---
---START---
CREATE TABLE array_op_test (gemini_pk serial PRIMARY KEY, seqno int8, i int8[], t text[]);
---END---
---START---
\set filename :abs_srcdir '/data/array.data'
COPY array_op_test FROM :'filename';
ERROR:  invalid input syntax for type bigint: "{92,75,71,52,64,83}"
CONTEXT:  COPY array_op_test, line 1, column seqno: "{92,75,71,52,64,83}"
---END---
---START---
ANALYZE array_op_test;
---END---
---START---
--
-- only the 'e' array is 0-based, the others are 1-based.
--
INSERT INTO arrtest (a[1:5], b[1:1][1:2][1:2], c, d, f, g)
   VALUES ('{1,2,3,4,5}', '{{{0,0},{1,2}}}', '{}', '{}', '{}', '{}');
---END---
---START---
UPDATE arrtest SET e[0] = '1.1';
---END---
---START---
UPDATE arrtest SET e[1] = '2.2';
---END---
---START---
INSERT INTO arrtest (f)
   VALUES ('{"too long"}');
ERROR:  value too long for type character varying(5)
---END---
---START---
INSERT INTO arrtest (a, b[1:2][1:2], c, d, e, f, g)
   VALUES ('{11,12,23}', '{{3,4},{4,5}}', '{"foobar"}',
           '{{"elt1", "elt2"}}', '{"3.4", "6.7"}',
           '{"abc","abcde"}', '{"abc","abcde"}');
---END---
---START---
INSERT INTO arrtest (a, b[1:2], c, d[1:2])
   VALUES ('{}', '{3,4}', '{foo,bar}', '{bar,foo}');
---END---
---START---
INSERT INTO arrtest (b[2]) VALUES(now());
ERROR:  subscripted assignment to "b" requires type bigint but expression is of type timestamp with time zone
LINE 1: INSERT INTO arrtest (b[2]) VALUES(now());
                             ^
HINT:  You will need to rewrite or cast the expression.
---END---
---START---
-- error, type mismatch
INSERT INTO arrtest (b[1:2]) VALUES(now());
ERROR:  subscripted assignment to "b" requires type bigint[] but expression is of type timestamp with time zone
LINE 1: INSERT INTO arrtest (b[1:2]) VALUES(now());
                             ^
HINT:  You will need to rewrite or cast the expression.
---END---
---START---
-- error, type mismatch
SELECT * FROM arrtest;
      a      |        b        |     c     |       d       |        e        |      f      |      g      
-------------+-----------------+-----------+---------------+-----------------+-------------+-------------
 {1,2,3,4,5} | {{{0,0},{1,2}}} | {}        | {}            | [0:1]={1.1,2.2} | {}          | {}
 {11,12,23}  | {{3,4},{4,5}}   | {foobar}  | {{elt1,elt2}} | {3.4,6.7}       | {abc,abcde} | {abc,abcde}
 {}          | {3,4}           | {foo,bar} | {bar,foo}     |                 |             | 
(3 rows)

---END---
---START---
SELECT arrtest.a[1],
          arrtest.b[1][1][1],
          arrtest.c[1],
          arrtest.d[1][1],
          arrtest.e[0]
   FROM arrtest;
 a  | b |   c    |  d   |  e  
----+---+--------+------+-----
  1 | 0 |        |      | 1.1
 11 |   | foobar | elt1 |    
    |   | foo    |      |    
(3 rows)

---END---
---START---
SELECT a[1], b[1][1][1], c[1], d[1][1], e[0]
   FROM arrtest;
 a  | b |   c    |  d   |  e  
----+---+--------+------+-----
  1 | 0 |        |      | 1.1
 11 |   | foobar | elt1 |    
    |   | foo    |      |    
(3 rows)

---END---
---START---
SELECT a[1:3],
          b[1:1][1:2][1:2],
          c[1:2],
          d[1:1][1:2]
   FROM arrtest;
     a      |        b        |     c     |       d       
------------+-----------------+-----------+---------------
 {1,2,3}    | {{{0,0},{1,2}}} | {}        | {}
 {11,12,23} | {}              | {foobar}  | {{elt1,elt2}}
 {}         | {}              | {foo,bar} | {}
(3 rows)

---END---
---START---
SELECT array_ndims(a) AS a,array_ndims(b) AS b,array_ndims(c) AS c
   FROM arrtest;
 a | b | c 
---+---+---
 1 | 3 |  
 1 | 2 | 1
   | 1 | 1
(3 rows)

---END---
---START---
SELECT array_dims(a) AS a,array_dims(b) AS b,array_dims(c) AS c
   FROM arrtest;
   a   |        b        |   c   
-------+-----------------+-------
 [1:5] | [1:1][1:2][1:2] | 
 [1:3] | [1:2][1:2]      | [1:1]
       | [1:2]           | [1:2]
(3 rows)

---END---
---START---
-- returns nothing
SELECT *
   FROM arrtest
   WHERE a[1] < 5 and
         c = '{"foobar"}'::_name;
ERROR:  operator does not exist: text[] = name[]
LINE 4:          c = '{"foobar"}'::_name;
                   ^
HINT:  No operator matches the given name and argument types. You might need to add explicit type casts.
---END---
---START---
UPDATE arrtest
  SET a[1:2] = '{16,25}'
  WHERE NOT a = '{}'::_int2;
ERROR:  operator does not exist: bigint[] = smallint[]
LINE 3:   WHERE NOT a = '{}'::_int2;
                      ^
HINT:  No operator matches the given name and argument types. You might need to add explicit type casts.
---END---
---START---
UPDATE arrtest
  SET b[1:1][1:1][1:2] = '{113, 117}',
      b[1:1][1:2][2:2] = '{142, 147}'
  WHERE array_dims(b) = '[1:1][1:2][1:2]';
---END---
---START---
UPDATE arrtest
  SET c[2:2] = '{"new_word"}'
  WHERE array_dims(c) is not null;
---END---
---START---
SELECT a,b,c FROM arrtest;
      a      |           b           |         c         
-------------+-----------------------+-------------------
 {1,2,3,4,5} | {{{113,142},{1,147}}} | {}
 {11,12,23}  | {{3,4},{4,5}}         | {foobar,new_word}
 {}          | {3,4}                 | {foo,new_word}
(3 rows)

---END---
---START---
SELECT a[1:3],
          b[1:1][1:2][1:2],
          c[1:2],
          d[1:1][2:2]
   FROM arrtest;
     a      |           b           |         c         |    d     
------------+-----------------------+-------------------+----------
 {1,2,3}    | {{{113,142},{1,147}}} | {}                | {}
 {11,12,23} | {}                    | {foobar,new_word} | {{elt2}}
 {}         | {}                    | {foo,new_word}    | {}
(3 rows)

---END---
---START---
SELECT b[1:1][2][2],
       d[1:1][2]
   FROM arrtest;
           b           |       d       
-----------------------+---------------
 {{{113,142},{1,147}}} | {}
 {}                    | {{elt1,elt2}}
 {}                    | {}
(3 rows)

---END---
---START---
INSERT INTO arrtest(a) VALUES('{1,null,3}');
---END---
---START---
SELECT a FROM arrtest;
      a      
-------------
 {1,2,3,4,5}
 {11,12,23}
 {}
 {1,NULL,3}
(4 rows)

---END---
---START---
UPDATE arrtest SET a[4] = NULL WHERE a[2] IS NULL;
---END---
---START---
SELECT a FROM arrtest WHERE a[2] IS NULL;
        a        
-----------------
 [4:4]={NULL}
 {1,NULL,3,NULL}
(2 rows)

---END---
---START---
DELETE FROM arrtest WHERE a[2] IS NULL AND b IS NULL;
---END---
---START---
SELECT a,b,c FROM arrtest;
      a       |           b           |         c         
--------------+-----------------------+-------------------
 {1,2,3,4,5}  | {{{113,142},{1,147}}} | {}
 {11,12,23}   | {{3,4},{4,5}}         | {foobar,new_word}
 [4:4]={NULL} | {3,4}                 | {foo,new_word}
(3 rows)

---END---
