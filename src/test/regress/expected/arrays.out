---START---
-- A few simple tests for arrays of composite types
create type comptype as (f1 int, f2 text);
---END---
---START---
CREATE TABLE comptable (gemini_pk serial PRIMARY KEY, c1 comptype, c2 comptype[]);
---END---
---START---
-- XXX would like to not have to specify row() construct types here ...
insert into comptable
  values (row(1,'foo'), array[row(2,'bar')::comptype, row(3,'baz')::comptype]);
ERROR:  column "gemini_pk" is of type integer but expression is of type record
LINE 2:   values (row(1,'foo'), array[row(2,'bar')::comptype, row(3,...
                  ^
HINT:  You will need to rewrite or cast the expression.
---END---
---START---
-- check that implicitly named array type _comptype isn't a problem
create type _comptype as enum('fooey');
---END---
---START---
select * from comptable;
 gemini_pk | c1 | c2 
-----------+----+----
(0 rows)

---END---
---START---
select c2[2].f2 from comptable;
 f2 
----
(0 rows)

---END---
---START---
drop type _comptype;
---END---
---START---
drop table comptable;
---END---
---START---
drop type comptype;
---END---
---START---
create or replace function unnest1(anyarray)
returns setof anyelement as $$
select $1[s] from generate_subscripts($1,1) g(s);
$$ language sql immutable;
---END---
---START---
create or replace function unnest2(anyarray)
returns setof anyelement as $$
select $1[s1][s2] from generate_subscripts($1,1) g1(s1),
                   generate_subscripts($1,2) g2(s2);
$$ language sql immutable;
---END---
---START---
select * from unnest1(array[1,2,3]);
 unnest1 
---------
       1
       2
       3
(3 rows)

---END---
---START---
select * from unnest2(array[[1,2,3],[4,5,6]]);
 unnest2 
---------
       1
       2
       3
       4
       5
       6
(6 rows)

---END---
---START---
drop function unnest1(anyarray);
---END---
---START---
drop function unnest2(anyarray);
---END---
