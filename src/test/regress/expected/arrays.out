---START---
-- Insert/update on a column that is array of composite
DROP TABLE IF EXISTS t1;
NOTICE:  table "t1" does not exist, skipping
CREATE TABLE t1 (gemini_pk serial PRIMARY KEY, f1 int8_tbl[]);
---END---
---START---
insert into t1 (f1[5].q1) values(42);
---END---
---START---
select * from t1;
 gemini_pk |        f1        
-----------+------------------
         1 | [5:5]={"(,42,)"}
(1 row)

---END---
---START---
update t1 set f1[5].q2 = 43;
---END---
---START---
select * from t1;
 gemini_pk |         f1         
-----------+--------------------
         1 | [5:5]={"(,42,43)"}
(1 row)

---END---
---START---
-- Check that arrays of composites are safely detoasted when needed
DROP TABLE IF EXISTS src;
NOTICE:  table "src" does not exist, skipping
CREATE TABLE src (gemini_pk serial PRIMARY KEY, f1 text);
---END---
---START---
insert into src
  select string_agg(random()::text,'') from generate_series(1,10000);
ERROR:  column "gemini_pk" is of type integer but expression is of type text
LINE 2:   select string_agg(random()::text,'') from generate_series(...
                 ^
HINT:  You will need to rewrite or cast the expression.
---END---
---START---
create type textandtext as (c1 text, c2 text);
---END---
---START---
DROP TABLE IF EXISTS dest;
NOTICE:  table "dest" does not exist, skipping
CREATE TABLE dest (gemini_pk serial PRIMARY KEY, f1 textandtext[]);
---END---
---START---
insert into dest select array[row(f1,f1)::textandtext] from src;
ERROR:  column "gemini_pk" is of type integer but expression is of type textandtext[]
LINE 1: insert into dest select array[row(f1,f1)::textandtext] from ...
                                ^
HINT:  You will need to rewrite or cast the expression.
---END---
---START---
select length(fipshash((f1[1]).c2)) from dest;
 length 
--------
(0 rows)

---END---
