---START---
-- Check edge cases
SELECT '23:59:59.999999 PDT'::timetz;
       timetz       
--------------------
 23:59:59.999999-07
(1 row)

---END---
---START---
SELECT '23:59:59.9999999 PDT'::timetz;
   timetz    
-------------
 24:00:00-07
(1 row)

---END---
---START---
-- rounds up
SELECT '23:59:60 PDT'::timetz;
   timetz    
-------------
 24:00:00-07
(1 row)

---END---
---START---
-- rounds up
SELECT '24:00:00 PDT'::timetz;
   timetz    
-------------
 24:00:00-07
(1 row)

---END---
