---START---
-- check rounding when casting from float
SELECT x, x::int4 AS int4_value
FROM (VALUES (-2.5::float8),
             (-1.5::float8),
             (-0.5::float8),
             (0.0::float8),
             (0.5::float8),
             (1.5::float8),
             (2.5::float8)) t(x);
  x   | int4_value 
------+------------
 -2.5 |         -2
 -1.5 |         -2
 -0.5 |          0
    0 |          0
  0.5 |          0
  1.5 |          2
  2.5 |          2
(7 rows)

---END---
---START---
-- check rounding when casting from numeric
SELECT x, x::int4 AS int4_value
FROM (VALUES (-2.5::numeric),
             (-1.5::numeric),
             (-0.5::numeric),
             (0.0::numeric),
             (0.5::numeric),
             (1.5::numeric),
             (2.5::numeric)) t(x);
  x   | int4_value 
------+------------
 -2.5 |         -3
 -1.5 |         -2
 -0.5 |         -1
  0.0 |          0
  0.5 |          1
  1.5 |          2
  2.5 |          3
(7 rows)

---END---
---START---
-- test gcd()
SELECT a, b, gcd(a, b), gcd(a, -b), gcd(b, a), gcd(-b, a)
FROM (VALUES (0::int4, 0::int4),
             (0::int4, 6410818::int4),
             (61866666::int4, 6410818::int4),
             (-61866666::int4, 6410818::int4),
             ((-2147483648)::int4, 1::int4),
             ((-2147483648)::int4, 2147483647::int4),
             ((-2147483648)::int4, 1073741824::int4)) AS v(a, b);
      a      |     b      |    gcd     |    gcd     |    gcd     |    gcd     
-------------+------------+------------+------------+------------+------------
           0 |          0 |          0 |          0 |          0 |          0
           0 |    6410818 |    6410818 |    6410818 |    6410818 |    6410818
    61866666 |    6410818 |       1466 |       1466 |       1466 |       1466
   -61866666 |    6410818 |       1466 |       1466 |       1466 |       1466
 -2147483648 |          1 |          1 |          1 |          1 |          1
 -2147483648 | 2147483647 |          1 |          1 |          1 |          1
 -2147483648 | 1073741824 | 1073741824 | 1073741824 | 1073741824 | 1073741824
(7 rows)

---END---
---START---
SELECT gcd((-2147483648)::int4, 0::int4);
ERROR:  integer out of range
---END---
---START---
-- overflow
SELECT gcd((-2147483648)::int4, (-2147483648)::int4);
ERROR:  integer out of range
---END---
---START---
-- overflow
-- test lcm()
SELECT a, b, lcm(a, b), lcm(a, -b), lcm(b, a), lcm(-b, a)
FROM (VALUES (0::int4, 0::int4),
             (0::int4, 42::int4),
             (42::int4, 42::int4),
             (330::int4, 462::int4),
             (-330::int4, 462::int4),
             ((-2147483648)::int4, 0::int4)) AS v(a, b);
      a      |  b  | lcm  | lcm  | lcm  | lcm  
-------------+-----+------+------+------+------
           0 |   0 |    0 |    0 |    0 |    0
           0 |  42 |    0 |    0 |    0 |    0
          42 |  42 |   42 |   42 |   42 |   42
         330 | 462 | 2310 | 2310 | 2310 | 2310
        -330 | 462 | 2310 | 2310 | 2310 | 2310
 -2147483648 |   0 |    0 |    0 |    0 |    0
(6 rows)

---END---
---START---
SELECT lcm((-2147483648)::int4, 1::int4);
ERROR:  integer out of range
---END---
---START---
-- overflow
SELECT lcm(2147483647::int4, 2147483646::int4);
ERROR:  integer out of range
---END---
