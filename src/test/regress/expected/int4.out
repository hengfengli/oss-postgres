---START---
--
-- INT4
--
-- int4_tbl was already created and filled in test_setup.sql.
-- Here we just try to insert bad values.
INSERT INTO INT4_TBL(f1) VALUES ('34.5');
ERROR:  invalid input syntax for type bigint: "34.5"
LINE 1: INSERT INTO INT4_TBL(f1) VALUES ('34.5');
                                         ^
---END---
---START---
INSERT INTO INT4_TBL(f1) VALUES ('1000000000000');
---END---
---START---
INSERT INTO INT4_TBL(f1) VALUES ('asdf');
ERROR:  invalid input syntax for type bigint: "asdf"
LINE 1: INSERT INTO INT4_TBL(f1) VALUES ('asdf');
                                         ^
---END---
---START---
INSERT INTO INT4_TBL(f1) VALUES ('     ');
ERROR:  invalid input syntax for type bigint: "     "
LINE 1: INSERT INTO INT4_TBL(f1) VALUES ('     ');
                                         ^
---END---
---START---
INSERT INTO INT4_TBL(f1) VALUES ('   asdf   ');
ERROR:  invalid input syntax for type bigint: "   asdf   "
LINE 1: INSERT INTO INT4_TBL(f1) VALUES ('   asdf   ');
                                         ^
---END---
---START---
INSERT INTO INT4_TBL(f1) VALUES ('- 1234');
ERROR:  invalid input syntax for type bigint: "- 1234"
LINE 1: INSERT INTO INT4_TBL(f1) VALUES ('- 1234');
                                         ^
---END---
---START---
INSERT INTO INT4_TBL(f1) VALUES ('123       5');
ERROR:  invalid input syntax for type bigint: "123       5"
LINE 1: INSERT INTO INT4_TBL(f1) VALUES ('123       5');
                                         ^
---END---
---START---
INSERT INTO INT4_TBL(f1) VALUES ('');
ERROR:  invalid input syntax for type bigint: ""
LINE 1: INSERT INTO INT4_TBL(f1) VALUES ('');
                                         ^
---END---
---START---
SELECT * FROM INT4_TBL;
 gemini_pk |      f1       
-----------+---------------
         1 |             0
         2 |        123456
         3 |       -123456
         4 |    2147483647
         5 |   -2147483647
         6 | 1000000000000
(6 rows)

---END---
---START---
-- Also try it with non-error-throwing API
SELECT pg_input_is_valid('34', 'int4');
 pg_input_is_valid 
-------------------
 t
(1 row)

---END---
---START---
SELECT pg_input_is_valid('asdf', 'int4');
 pg_input_is_valid 
-------------------
 f
(1 row)

---END---
---START---
SELECT pg_input_is_valid('1000000000000', 'int4');
 pg_input_is_valid 
-------------------
