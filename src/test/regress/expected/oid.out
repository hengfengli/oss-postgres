---START---
CREATE TABLE oid_tbl (gemini_pk serial PRIMARY KEY, f1 oid);
---END---
---START---
INSERT INTO OID_TBL(f1) VALUES ('1234');
---END---
---START---
INSERT INTO OID_TBL(f1) VALUES ('1235');
---END---
---START---
