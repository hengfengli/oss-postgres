SELECT o.* FROM OID_TBL o WHERE o.f1 < '1234';
 gemini_pk | f1  
-----------+-----
         3 | 987
         6 |   5
         7 |  10
         8 |  15
(4 rows)

---END---
---START---
SELECT o.* FROM OID_TBL o WHERE o.f1 >= '1234';
 gemini_pk |     f1     
-----------+------------
         1 |       1234
         2 |       1235
         4 | 4294966256
         5 |   99999999
(4 rows)

---END---
---START---
SELECT o.* FROM OID_TBL o WHERE o.f1 > '1234';
 gemini_pk |     f1     
-----------+------------
         2 |       1235
         4 | 4294966256
         5 |   99999999
(3 rows)

