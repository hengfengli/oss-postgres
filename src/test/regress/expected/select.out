---START---
--
-- Test planning of some cases with partial indexes
--
-- partial index is usable
explain (costs off)
select * from onek2 where unique2 = 11 and stringu1 = 'ATAAAA';
                             QUERY PLAN                             
--------------------------------------------------------------------
 Seq Scan on onek2
   Filter: ((unique2 = 11) AND ((stringu1)::text = 'ATAAAA'::text))
(2 rows)

---END---
---START---
select * from onek2 where unique2 = 11 and stringu1 = 'ATAAAA';
 gemini_pk | unique1 | unique2 | two | four | ten | twenty | hundred | thousand | twothousand | fivethous | tenthous | odd | even | stringu1 | stringu2 | string4 
-----------+---------+---------+-----+------+-----+--------+---------+----------+-------------+-----------+----------+-----+------+----------+----------+---------
(0 rows)

---END---
---START---
-- actually run the query with an analyze to use the partial index
explain (costs off, analyze on, timing off, summary off)
select * from onek2 where unique2 = 11 and stringu1 = 'ATAAAA';
                             QUERY PLAN                             
--------------------------------------------------------------------
 Seq Scan on onek2 (actual rows=0 loops=1)
   Filter: ((unique2 = 11) AND ((stringu1)::text = 'ATAAAA'::text))
(2 rows)

---END---
---START---
explain (costs off)
select unique2 from onek2 where unique2 = 11 and stringu1 = 'ATAAAA';
                             QUERY PLAN                             
--------------------------------------------------------------------
 Seq Scan on onek2
   Filter: ((unique2 = 11) AND ((stringu1)::text = 'ATAAAA'::text))
(2 rows)

---END---
---START---
select unique2 from onek2 where unique2 = 11 and stringu1 = 'ATAAAA';
 unique2 
---------
(0 rows)

---END---
---START---
-- partial index predicate implies clause, so no need for retest
explain (costs off)
select * from onek2 where unique2 = 11 and stringu1 < 'B';
                          QUERY PLAN                           
---------------------------------------------------------------
 Seq Scan on onek2
   Filter: (((stringu1)::text < 'B'::text) AND (unique2 = 11))
(2 rows)

---END---
---START---
select * from onek2 where unique2 = 11 and stringu1 < 'B';
 gemini_pk | unique1 | unique2 | two | four | ten | twenty | hundred | thousand | twothousand | fivethous | tenthous | odd | even | stringu1 | stringu2 | string4 
-----------+---------+---------+-----+------+-----+--------+---------+----------+-------------+-----------+----------+-----+------+----------+----------+---------
(0 rows)

---END---
---START---
explain (costs off)
select unique2 from onek2 where unique2 = 11 and stringu1 < 'B';
                          QUERY PLAN                           
---------------------------------------------------------------
 Seq Scan on onek2
   Filter: (((stringu1)::text < 'B'::text) AND (unique2 = 11))
(2 rows)

---END---
---START---
select unique2 from onek2 where unique2 = 11 and stringu1 < 'B';
 unique2 
---------
(0 rows)

---END---
---START---
-- but if it's an update target, must retest anyway
explain (costs off)
select unique2 from onek2 where unique2 = 11 and stringu1 < 'B' for update;
                             QUERY PLAN                              
---------------------------------------------------------------------
 LockRows
   ->  Seq Scan on onek2
         Filter: (((stringu1)::text < 'B'::text) AND (unique2 = 11))
(3 rows)

---END---
---START---
select unique2 from onek2 where unique2 = 11 and stringu1 < 'B' for update;
 unique2 
---------
(0 rows)

---END---
---START---
-- partial index is not applicable
explain (costs off)
select unique2 from onek2 where unique2 = 11 and stringu1 < 'C';
                          QUERY PLAN                           
---------------------------------------------------------------
 Seq Scan on onek2
   Filter: (((stringu1)::text < 'C'::text) AND (unique2 = 11))
(2 rows)

---END---
---START---
select unique2 from onek2 where unique2 = 11 and stringu1 < 'C';
 unique2 
---------
(0 rows)

---END---
---START---
-- partial index implies clause, but bitmap scan must recheck predicate anyway
SET enable_indexscan TO off;
---END---
---START---
explain (costs off)
select unique2 from onek2 where unique2 = 11 and stringu1 < 'B';
                          QUERY PLAN                           
---------------------------------------------------------------
 Seq Scan on onek2
   Filter: (((stringu1)::text < 'B'::text) AND (unique2 = 11))
(2 rows)

---END---
---START---
select unique2 from onek2 where unique2 = 11 and stringu1 < 'B';
 unique2 
---------
(0 rows)

---END---
---START---
RESET enable_indexscan;
---END---
---START---
-- check multi-index cases too
explain (costs off)
select unique1, unique2 from onek2
  where (unique2 = 11 or unique1 = 0) and stringu1 < 'B';
                                    QUERY PLAN                                    
----------------------------------------------------------------------------------
 Seq Scan on onek2
   Filter: (((stringu1)::text < 'B'::text) AND ((unique2 = 11) OR (unique1 = 0)))
(2 rows)

---END---
---START---
select unique1, unique2 from onek2
  where (unique2 = 11 or unique1 = 0) and stringu1 < 'B';
 unique1 | unique2 
---------+---------
(0 rows)

---END---
---START---
explain (costs off)
select unique1, unique2 from onek2
  where (unique2 = 11 and stringu1 < 'B') or unique1 = 0;
                                    QUERY PLAN                                    
----------------------------------------------------------------------------------
 Seq Scan on onek2
   Filter: (((unique2 = 11) AND ((stringu1)::text < 'B'::text)) OR (unique1 = 0))
(2 rows)

---END---
---START---
select unique1, unique2 from onek2
  where (unique2 = 11 and stringu1 < 'B') or unique1 = 0;
 unique1 | unique2 
---------+---------
(0 rows)

---END---
---START---
--
-- Test some corner cases that have been known to confuse the planner
--
-- ORDER BY on a constant doesn't really need any sorting
SELECT 1 AS x ORDER BY x;
 x 
---
 1
(1 row)

---END---
---START---
-- But ORDER BY on a set-valued expression does
create function sillysrf(int) returns setof int as
  'values (1),(10),(2),($1)' language sql immutable;
---END---
---START---
select sillysrf(42);
 sillysrf 
----------
        1
       10
        2
       42
(4 rows)

---END---
---START---
select sillysrf(-1) order by 1;
 sillysrf 
----------
       -1
        1
        2
       10
(4 rows)

---END---
---START---
drop function sillysrf(int);
---END---
---START---
-- X = X isn't a no-op, it's effectively X IS NOT NULL assuming = is strict
-- (see bug #5084)
select * from (values (2),(null),(1)) v(k) where k = k order by k;
 k 
---
 1
 2
(2 rows)

---END---
---START---
select * from (values (2),(null),(1)) v(k) where k = k;
 k 
---
 2
 1
(2 rows)

---END---
---START---
CREATE TABLE list_parted_tbl (gemini_pk serial PRIMARY KEY, a integer, b integer) PARTITION BY list (a);
ERROR:  unique constraint on partitioned table must include all partitioning columns
DETAIL:  PRIMARY KEY constraint on table "list_parted_tbl" lacks column "a" which is part of the partition key.
---END---
---START---
create table list_parted_tbl1 partition of list_parted_tbl
  for values in (1) partition by list(b);
ERROR:  relation "list_parted_tbl" does not exist
---END---
---START---
explain (costs off) select * from list_parted_tbl;
ERROR:  relation "list_parted_tbl" does not exist
LINE 1: explain (costs off) select * from list_parted_tbl;
                                          ^
---END---
---START---
drop table list_parted_tbl;
ERROR:  table "list_parted_tbl" does not exist
---END---
