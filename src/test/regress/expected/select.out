SELECT p.name, p.age FROM person* p;
 name | age 
------+-----
(0 rows)

---END---
---START---
--
-- awk '{print $1,$2;}' person.data |
-- awk '{if(NF!=2){print $3,$2;}else{print;}}' - emp.data |
-- awk '{if(NF!=2){print $3,$2;}else{print;}}' - student.data |
