---START---
-- positive odds
SELECT i.* FROM INT2_TBL i WHERE (i.f1 % int2 '2') = int2 '1';
 gemini_pk |  f1   
-----------+-------
         4 | 32767
(1 row)

---END---
---START---
-- any evens
SELECT i.* FROM INT2_TBL i WHERE (i.f1 % int4 '2') = int2 '0';
 gemini_pk |   f1   
-----------+--------
         1 |      0
         2 |   1234
         3 |  -1234
         6 | 100000
(4 rows)

---END---
---START---
SELECT i.f1, i.f1 * int2 '2' AS x FROM INT2_TBL i;
   f1   |   x    
--------+--------
      0 |      0
   1234 |   2468
  -1234 |  -2468
  32767 |  65534
 -32767 | -65534
 100000 | 200000
(6 rows)

---END---
---START---
SELECT i.f1, i.f1 * int2 '2' AS x FROM INT2_TBL i
WHERE abs(f1) < 16384;
  f1   |   x   
-------+-------
     0 |     0
  1234 |  2468
 -1234 | -2468
(3 rows)

---END---
